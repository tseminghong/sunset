{
  "name": "ict-sync-api",
  "version": "1.0.0",
  "description": "Cloudflare Worker API for ICT Revision Hub multi-platform sync",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:create": "wrangler d1 create ict-sync-db",
    "db:migrate": "wrangler d1 migrations apply ict-sync-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply ict-sync-db --remote",
    "db:studio": "wrangler d1 execute ict-sync-db --local --command='SELECT * FROM users LIMIT 10'",
    "test": "vitest"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "sync",
    "api",
    "d1"
  ],
  "author": "HPCSS ICT Team",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.0",
    "wrangler": "^3.80.0"
  },
  "dependencies": {
    "hono": "^3.12.0",
    "jose": "^5.2.0"
  }
}
